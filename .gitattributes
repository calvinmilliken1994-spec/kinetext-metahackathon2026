# Keep line endings as LF everywhere so hashes and diffs match across platforms.
* text=auto eol=lf
# Stored source texts are hashed (sha256) byte-for-byte: never rewrite their line endings.
data/sources/*.txt -text
*.png binary
*.jpg binary
data/figures/*.json -text
# Shipped demo runs and project-authored user sources: kept byte-for-byte (stored runs are evidence).
data/demo-runs/** -text

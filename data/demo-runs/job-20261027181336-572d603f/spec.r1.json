  "explanations": [
    {
      "evidence": [
        {
          "quote": "On the Moon there is no air, so a thrown ball feels no drag at all.",
          "sourceId": "user-accf5f60ebed"
        }
      ],
      "id": "no-drag-ballistic-flight",
      "text": "Without air there is no drag, so flight is purely ballistic with weight pulling straight down."
    },
    {
      "evidence": [
        {
          "quote": "Nothing pushes the ball sideways, so the horizontal speed stays U0 for the whole flight and the ball moves x = U0 * t across the ground.",
          "sourceId": "user-accf5f60ebed"
        }
      ],
      "id": "horizontal-motion-constant",
      "text": "With no sideways push, horizontal speed stays U0 and ground distance grows as x = U0 * t."
    },
    {
      "evidence": [
        {
          "quote": "The vertical speed is V = V0 - g * t, and the height is y = V0 * t - g * t^2 / 2.",
          "sourceId": "user-accf5f60ebed"
        },
        {
          "quote": "Putting that time into the height equation gives the highest point: ymax = V0^2 / (2 * g).",
          "sourceId": "user-accf5f60ebed"
        }
      ],
      "id": "maximum-height-gravity",
      "text": "Vertical motion slows under gravity and peaks at ymax = V0^2 / (2 * g), so smaller g gives a higher rise."
    }
  ],

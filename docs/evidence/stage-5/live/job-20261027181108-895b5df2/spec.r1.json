  "explanations": [
    {
      "evidence": [
        {
          "quote": "The horizontal motion is uniform because there is no external force in the horizontal direction.",
          "sourceId": "nasa-grc-ballistic-flight-equations"
        }
      ],
      "id": "horizontal-uniform-motion",
      "text": "With no drag and no horizontal force, horizontal velocity stays constant and downrange distance grows steadily with time."
    },
    {
      "evidence": [
        {
          "quote": "V = V0 - g * t",
          "sourceId": "nasa-grc-ballistic-flight-equations"
        },
        {
          "quote": "y = V0 * t - (g * t^2) / 2",
          "sourceId": "nasa-grc-ballistic-flight-equations"
        }
      ],
      "id": "vertical-motion-under-gravity",
      "text": "Gravity is the only vertical force, so vertical velocity decreases linearly with time and height follows a quadratic curve."
    },
    {
      "evidence": [
        {
          "quote": "At the highest point in the flight, the vertical velocity is zero.",
          "sourceId": "nasa-grc-ballistic-flight-equations"
        },
        {
          "quote": "y = V0^2 / (2 * g)",
          "sourceId": "nasa-grc-ballistic-flight-equations"
        }
      ],
      "id": "maximum-altitude",
      "text": "Maximum height occurs when vertical velocity reaches zero, giving y_max from initial vertical velocity and gravity; doubling vertical speed quadruples height."
    }
  ],

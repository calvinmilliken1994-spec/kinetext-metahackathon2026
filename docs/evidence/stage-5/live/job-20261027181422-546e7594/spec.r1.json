  "explanations": [
    {
      "evidence": [
        {
          "quote": "lift L equals the lift coefficient Cl times the air density rho",
          "sourceId": "user-0e818e7ef9c1"
        },
        {
          "quote": "L = Cl * (rho * V^2 / 2) * A",
          "sourceId": "user-0e818e7ef9c1"
        }
      ],
      "id": "lift-equation",
      "text": "Lift equals the lift coefficient times air density times half the velocity squared times wing area."
    },
    {
      "evidence": [
        {
          "quote": "Doubling the airspeed makes the lift four times larger, because lift depends on the square of the velocity.",
          "sourceId": "user-0e818e7ef9c1"
        }
      ],
      "id": "velocity-squared-scaling",
      "text": "Doubling airspeed makes lift four times larger because lift depends on the square of velocity."
    },
    {
      "evidence": [
        {
          "quote": "A bigger wing area gives proportionally more lift.",
          "sourceId": "user-0e818e7ef9c1"
        },
        {
          "quote": "For a small balsa glider at sea level, the air density is about 1.225 kg/m^3.",
          "sourceId": "user-0e818e7ef9c1"
        }
      ],
      "id": "area-and-density",
      "text": "At sea-level density, a larger wing area gives proportionally more lift."
    }

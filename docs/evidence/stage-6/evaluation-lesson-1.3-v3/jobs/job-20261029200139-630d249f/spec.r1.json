  "explanations": [
    {
      "evidence": [
        {
          "quote": "The Mach number is the ratio of the speed of the aircraft, or the speed of the gas, to the speed of sound in the gas.",
          "sourceId": "nasa-grc-role-of-the-mach-number"
        }
      ],
      "id": "mach-number-definition",
      "text": "Mach number compares gas or aircraft speed to the local speed of sound."
    },
    {
      "evidence": [
        {
          "quote": "gamma * R * T = a^2",
          "sourceId": "nasa-grc-role-of-the-mach-number"
        },
        {
          "quote": "where a is equal to the speed of sound. So,",
          "sourceId": "nasa-grc-role-of-the-mach-number"
        }
      ],
      "id": "speed-of-sound-formula",
      "text": "The square of the sound speed equals gamma times R times absolute temperature."
    },
    {
      "evidence": [
        {
          "quote": "For the low subsonic conditions, compressibility can be ignored.",
          "sourceId": "nasa-grc-role-of-the-mach-number"
        },
        {
          "quote": "where gamma (γ) is the specific heat ratio.",
          "sourceId": "nasa-grc-role-of-the-mach-number"
        }
      ],
      "id": "compressibility-and-gamma",
      "text": "At low subsonic speeds density change is small, while gamma links pressure and density changes."
    }
  ],

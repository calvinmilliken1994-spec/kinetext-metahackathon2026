{
  "name": "meta-hackathon-2026",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Make knowledge interactive. Product name provisional.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"packages/**/*.test.ts\" \"workers/**/*.test.ts\" \"apps/api/**/*.test.ts\" \"tests/**/*.test.ts\" \"tests/**/*.test.mjs\" \"apps/web/src/lib/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test",
    "smoke:meta": "node --env-file-if-exists=.env.local scripts/meta-smoke.mjs",
    "start": "node scripts/start.mjs",
    "api": "node apps/api/main.ts",
    "live:spike": "node scripts/live-spike.ts",
    "web": "npm --prefix apps/web run dev",
    "web:build": "npm --prefix apps/web run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "ajv": "8.17.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@meta-sam/parser": "0.1.0"
  }
}

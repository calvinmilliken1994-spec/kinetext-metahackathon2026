{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://make-knowledge-interactive.local/schemas/activity-spec.full.projectile-v1.json",
  "title": "Activity spec (full) — Ballistic flight without drag",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "learningObjectives",
    "sources",
    "explanations",
    "simulation",
    "behavioralTests",
    "predictions",
    "execution",
    "provenance"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.3.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "learningObjectives": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "locator",
          "license",
          "attribution",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "license": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "attribution": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          }
        }
      }
    },
    "explanations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "evidence": {
            "$ref": "#/definitions/evidenceList"
          }
        }
      }
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "equation",
        "horizontalSpeedMps",
        "verticalSpeedMps",
        "gravityMps2",
        "scenario"
      ],
      "properties": {
        "engine": {
          "const": "projectile-v1"
        },
        "equation": {
          "const": "y_max=V0^2/(2*g)"
        },
        "horizontalSpeedMps": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unit",
            "min",
            "max",
            "default"
          ],
          "properties": {
            "unit": {
              "const": "m/s"
            },
            "min": {
              "type": "number",
              "minimum": 0,
              "maximum": 200
            },
            "max": {
              "type": "number",
              "minimum": 0,
              "maximum": 200
            },
            "default": {
              "type": "number",
              "minimum": 0,
              "maximum": 200
            }
          }
        },
        "verticalSpeedMps": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unit",
            "min",
            "max",
            "default"
          ],
          "properties": {
            "unit": {
              "const": "m/s"
            },
            "min": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 200
            },
            "max": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 200
            },
            "default": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 200
            }
          }
        },
        "gravityMps2": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unit",
            "min",
            "max",
            "default"
          ],
          "properties": {
            "unit": {
              "const": "m/s^2"
            },
            "min": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 30
            },
            "max": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 30
            },
            "default": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 30
            }
          }
        },
        "scenario": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "objectLabel",
            "settingLabel"
          ],
          "properties": {
            "objectLabel": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "settingLabel": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            }
          }
        }
      }
    },
    "behavioralTests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "horizontalSpeedMps",
          "verticalSpeedMps",
          "gravityMps2",
          "expectedMaxHeightM",
          "tolerance"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "horizontalSpeedMps": {
            "type": "number",
            "minimum": 0,
            "maximum": 200
          },
          "verticalSpeedMps": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 200
          },
          "gravityMps2": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 30
          },
          "expectedMaxHeightM": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000
          },
          "tolerance": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 5000
          }
        }
      }
    },
    "predictions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "prompt",
          "horizontalSpeedMps",
          "verticalSpeedMps",
          "gravityMps2",
          "expectedMaxHeightM",
          "tolerance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "horizontalSpeedMps": {
            "type": "number",
            "minimum": 0,
            "maximum": 200
          },
          "verticalSpeedMps": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 200
          },
          "gravityMps2": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 30
          },
          "expectedMaxHeightM": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000
          },
          "tolerance": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 5000
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxWallTimeMs",
        "maxRepairAttempts",
        "network",
        "generatedCodeAllowed"
      ],
      "properties": {
        "maxWallTimeMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 10000
        },
        "maxRepairAttempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "network": {
          "const": false
        },
        "generatedCodeAllowed": {
          "const": false
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "requestedModel",
        "returnedModel",
        "responseId",
        "runId",
        "promptVersion",
        "revision",
        "repairOf",
        "generatedAt"
      ],
      "properties": {
        "provider": {
          "const": "meta"
        },
        "requestedModel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "returnedModel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "responseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "promptVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "repairOf": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "generatedAt": {
          "type": "string",
          "minLength": 20,
          "maxLength": 40
        }
      }
    }
  },
  "definitions": {
    "evidenceList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "quote"
        ],
        "properties": {
          "sourceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "quote": {
            "type": "string",
            "minLength": 3,
            "maxLength": 300
          }
        }
      }
    }
  }
}

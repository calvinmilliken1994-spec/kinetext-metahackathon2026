{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "learningObjectives",
    "explanations",
    "simulation",
    "behavioralTests",
    "predictions"
  ],
  "properties": {
    "title": {
      "type": "string",
      "description": "Short activity title for students."
    },
    "learningObjectives": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "1-5 measurable objectives grounded in the source."
    },
    "explanations": {
      "type": "array",
      "description": "1-6 short explanations, each supported by verbatim quotes from the source.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "lowercase-kebab id"
          },
          "text": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sourceId",
                "quote"
              ],
              "properties": {
                "sourceId": {
                  "type": "string"
                },
                "quote": {
                  "type": "string",
                  "description": "Exact characters copied from the source, no ellipsis, 150 characters or fewer."
                }
              }
            }
          }
        }
      }
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principalUSD",
        "annualRatePercent",
        "compoundsPerYear",
        "years",
        "scenario"
      ],
      "properties": {
        "principalUSD": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max",
            "default"
          ],
          "description": "Slider range for Starting amount P in USD.",
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "default": {
              "type": "number"
            }
          }
        },
        "annualRatePercent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max",
            "default"
          ],
          "description": "Slider range for Annual interest rate r in %.",
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "default": {
              "type": "number"
            }
          }
        },
        "compoundsPerYear": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max",
            "default"
          ],
          "description": "Slider range for Compounding periods per year n in per year.",
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "default": {
              "type": "number"
            }
          }
        },
        "years": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max",
            "default"
          ],
          "description": "Slider range for Time t in years.",
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "default": {
              "type": "number"
            }
          }
        },
        "scenario": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "objectLabel",
            "settingLabel"
          ],
          "properties": {
            "objectLabel": {
              "type": "string"
            },
            "settingLabel": {
              "type": "string"
            }
          }
        }
      }
    },
    "behavioralTests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "principalUSD",
          "annualRatePercent",
          "compoundsPerYear",
          "years",
          "expectedAmountUSD",
          "tolerance"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "principalUSD": {
            "type": "number",
            "description": "Starting amount P in USD"
          },
          "annualRatePercent": {
            "type": "number",
            "description": "Annual interest rate r in %"
          },
          "compoundsPerYear": {
            "type": "number",
            "description": "Compounding periods per year n in per year"
          },
          "years": {
            "type": "number",
            "description": "Time t in years"
          },
          "expectedAmountUSD": {
            "type": "number",
            "description": "Amount after t years in USD, computed with A=P*(1+r/(100*n))^(n*t) from the inputs of this case."
          },
          "tolerance": {
            "type": "number",
            "description": "Allowed absolute difference from the exact value; small and positive."
          }
        }
      }
    },
    "predictions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "prompt",
          "principalUSD",
          "annualRatePercent",
          "compoundsPerYear",
          "years",
          "expectedAmountUSD",
          "tolerance"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "principalUSD": {
            "type": "number",
            "description": "Starting amount P in USD"
          },
          "annualRatePercent": {
            "type": "number",
            "description": "Annual interest rate r in %"
          },
          "compoundsPerYear": {
            "type": "number",
            "description": "Compounding periods per year n in per year"
          },
          "years": {
            "type": "number",
            "description": "Time t in years"
          },
          "expectedAmountUSD": {
            "type": "number",
            "description": "Amount after t years in USD, computed with A=P*(1+r/(100*n))^(n*t) from the inputs of this case."
          },
          "tolerance": {
            "type": "number",
            "description": "Allowed absolute difference from the exact value; small and positive."
          }
        }
      }
    }
  }
}

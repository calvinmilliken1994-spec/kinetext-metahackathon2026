{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "learningObjectives",
    "explanations",
    "simulation",
    "behavioralTests",
    "predictions"
  ],
  "properties": {
    "title": {
      "type": "string",
      "description": "Short activity title for students."
    },
    "learningObjectives": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "1-5 measurable objectives grounded in the source."
    },
    "explanations": {
      "type": "array",
      "description": "1-6 short explanations, each supported by verbatim quotes from the source.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "lowercase-kebab id"
          },
          "text": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sourceId",
                "quote"
              ],
              "properties": {
                "sourceId": {
                  "type": "string"
                },
                "quote": {
                  "type": "string",
                  "description": "Exact characters copied from the source, no ellipsis, 150 characters or fewer."
                }
              }
            }
          }
        }
      }
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "liftCoefficient",
        "airDensityKgM3",
        "airspeedMps",
        "wingAreaM2",
        "scenario"
      ],
      "properties": {
        "liftCoefficient": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max",
            "default"
          ],
          "description": "Slider range for Lift coefficient Cl (dimensionless).",
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "default": {
              "type": "number"
            }
          }
        },
        "airDensityKgM3": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max",
            "default"
          ],
          "description": "Slider range for Air density rho in kg/m^3.",
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "default": {
              "type": "number"
            }
          }
        },
        "airspeedMps": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max",
            "default"
          ],
          "description": "Slider range for Velocity V in m/s.",
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "default": {
              "type": "number"
            }
          }
        },
        "wingAreaM2": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max",
            "default"
          ],
          "description": "Slider range for Wing area A in m^2.",
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "default": {
              "type": "number"
            }
          }
        },
        "scenario": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "objectLabel",
            "settingLabel"
          ],
          "properties": {
            "objectLabel": {
              "type": "string"
            },
            "settingLabel": {
              "type": "string"
            }
          }
        }
      }
    },
    "behavioralTests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "liftCoefficient",
          "airDensityKgM3",
          "airspeedMps",
          "wingAreaM2",
          "expectedLiftN",
          "tolerance"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "liftCoefficient": {
            "type": "number",
            "description": "Lift coefficient Cl (dimensionless)"
          },
          "airDensityKgM3": {
            "type": "number",
            "description": "Air density rho in kg/m^3"
          },
          "airspeedMps": {
            "type": "number",
            "description": "Velocity V in m/s"
          },
          "wingAreaM2": {
            "type": "number",
            "description": "Wing area A in m^2"
          },
          "expectedLiftN": {
            "type": "number",
            "description": "Lift in N, computed with L=Cl*(rho*V^2/2)*A from the inputs of this case."
          },
          "tolerance": {
            "type": "number",
            "description": "Allowed absolute difference from the exact value; small and positive."
          }
        }
      }
    },
    "predictions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "prompt",
          "liftCoefficient",
          "airDensityKgM3",
          "airspeedMps",
          "wingAreaM2",
          "expectedLiftN",
          "tolerance"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "liftCoefficient": {
            "type": "number",
            "description": "Lift coefficient Cl (dimensionless)"
          },
          "airDensityKgM3": {
            "type": "number",
            "description": "Air density rho in kg/m^3"
          },
          "airspeedMps": {
            "type": "number",
            "description": "Velocity V in m/s"
          },
          "wingAreaM2": {
            "type": "number",
            "description": "Wing area A in m^2"
          },
          "expectedLiftN": {
            "type": "number",
            "description": "Lift in N, computed with L=Cl*(rho*V^2/2)*A from the inputs of this case."
          },
          "tolerance": {
            "type": "number",
            "description": "Allowed absolute difference from the exact value; small and positive."
          }
        }
      }
    }
  }
}

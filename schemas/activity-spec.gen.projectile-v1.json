{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "learningObjectives",
    "explanations",
    "simulation",
    "behavioralTests",
    "predictions"
  ],
  "properties": {
    "title": {
      "type": "string",
      "description": "Short activity title for students."
    },
    "learningObjectives": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "1-5 measurable objectives grounded in the source."
    },
    "explanations": {
      "type": "array",
      "description": "1-6 short explanations, each supported by verbatim quotes from the source.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "lowercase-kebab id"
          },
          "text": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sourceId",
                "quote"
              ],
              "properties": {
                "sourceId": {
                  "type": "string"
                },
                "quote": {
                  "type": "string",
                  "description": "Exact characters copied from the source, no ellipsis, 150 characters or fewer."
                }
              }
            }
          }
        }
      }
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "horizontalSpeedMps",
        "verticalSpeedMps",
        "gravityMps2",
        "scenario"
      ],
      "properties": {
        "horizontalSpeedMps": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max",
            "default"
          ],
          "description": "Slider range for Initial horizontal speed U0 in m/s.",
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "default": {
              "type": "number"
            }
          }
        },
        "verticalSpeedMps": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max",
            "default"
          ],
          "description": "Slider range for Initial vertical speed V0 in m/s.",
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "default": {
              "type": "number"
            }
          }
        },
        "gravityMps2": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max",
            "default"
          ],
          "description": "Slider range for Gravitational acceleration g in m/s^2.",
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "default": {
              "type": "number"
            }
          }
        },
        "scenario": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "objectLabel",
            "settingLabel"
          ],
          "properties": {
            "objectLabel": {
              "type": "string"
            },
            "settingLabel": {
              "type": "string"
            }
          }
        }
      }
    },
    "behavioralTests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "horizontalSpeedMps",
          "verticalSpeedMps",
          "gravityMps2",
          "expectedMaxHeightM",
          "tolerance"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "horizontalSpeedMps": {
            "type": "number",
            "description": "Initial horizontal speed U0 in m/s"
          },
          "verticalSpeedMps": {
            "type": "number",
            "description": "Initial vertical speed V0 in m/s"
          },
          "gravityMps2": {
            "type": "number",
            "description": "Gravitational acceleration g in m/s^2"
          },
          "expectedMaxHeightM": {
            "type": "number",
            "description": "Maximum height in m, computed with y_max=V0^2/(2*g) from the inputs of this case."
          },
          "tolerance": {
            "type": "number",
            "description": "Allowed absolute difference from the exact value; small and positive."
          }
        }
      }
    },
    "predictions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "prompt",
          "horizontalSpeedMps",
          "verticalSpeedMps",
          "gravityMps2",
          "expectedMaxHeightM",
          "tolerance"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "horizontalSpeedMps": {
            "type": "number",
            "description": "Initial horizontal speed U0 in m/s"
          },
          "verticalSpeedMps": {
            "type": "number",
            "description": "Initial vertical speed V0 in m/s"
          },
          "gravityMps2": {
            "type": "number",
            "description": "Gravitational acceleration g in m/s^2"
          },
          "expectedMaxHeightM": {
            "type": "number",
            "description": "Maximum height in m, computed with y_max=V0^2/(2*g) from the inputs of this case."
          },
          "tolerance": {
            "type": "number",
            "description": "Allowed absolute difference from the exact value; small and positive."
          }
        }
      }
    }
  }
}

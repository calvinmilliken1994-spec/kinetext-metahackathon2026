{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "title",
    "attributes",
    "rows"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": [
        "compare-table-v1"
      ],
      "description": "Generator schema version, always the component id."
    },
    "title": {
      "type": "string",
      "description": "Short title for students in plain text."
    },
    "attributes": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "Attribute name in plain text."
      },
      "minItems": 2,
      "maxItems": 5,
      "description": "Shared attributes."
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entity",
          "values"
        ],
        "properties": {
          "entity": {
            "type": "string",
            "description": "Row name written with the words the page uses, never an id."
          },
          "values": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "sourceId",
                "quote"
              ],
              "properties": {
                "value": {
                  "type": "string",
                  "description": "Cell value in plain text, 1 to 80 characters. It occurs in the quote."
                },
                "sourceId": {
                  "type": "string",
                  "description": "Id of the source the quote was copied from."
                },
                "quote": {
                  "type": "string",
                  "description": "Exact characters copied from the source, no ellipsis, 150 characters or fewer."
                }
              }
            },
            "minItems": 2,
            "maxItems": 5,
            "description": "One value per column, in the same order as attributes."
          }
        }
      },
      "minItems": 2,
      "maxItems": 4,
      "description": "Compared rows."
    }
  }
}

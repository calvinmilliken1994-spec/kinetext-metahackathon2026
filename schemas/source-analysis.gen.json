{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "supported",
    "activity",
    "unsupportedReason",
    "concepts",
    "objectives"
  ],
  "properties": {
    "supported": {
      "type": "boolean",
      "description": "True only if one of the listed activity engines fits what the source teaches; otherwise false."
    },
    "activity": {
      "type": "string",
      "enum": [
        "forces-1d-v1",
        "projectile-v1",
        "lift-equation-v1",
        "speed-of-sound-v1",
        "compound-interest-v1",
        "hardy-weinberg-v1",
        "half-life-v1",
        "timeline-v1",
        "none"
      ],
      "description": "The single best-fitting engine id, or 'none' when unsupported."
    },
    "unsupportedReason": {
      "type": "string",
      "description": "Empty string when supported."
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "lowercase-kebab id"
          },
          "name": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sourceId",
                "quote"
              ],
              "properties": {
                "sourceId": {
                  "type": "string"
                },
                "quote": {
                  "type": "string",
                  "description": "Exact characters copied from the source, no ellipsis, 150 characters or fewer."
                }
              }
            }
          }
        }
      }
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
